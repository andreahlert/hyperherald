{
  "name": "hyperstream.org",
  "description": "declarative server-push hypermedia for the web",
  "keywords": [
    "hypermedia",
    "SSE",
    "WebSocket",
    "real-time",
    "HTML",
    "htmx"
  ],
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://hyperstream.org/",
  "bugs": {
    "url": "https://github.com/andreahlert/hyperstream/issues"
  },
  "license": "0BSD",
  "files": [
    "LICENSE",
    "README.md",
    "dist/*"
  ],
  "main": "dist/_hyperstream.js",
  "module": "dist/_hyperstream.esm.js",
  "exports": {
    ".": {
      "import": "./dist/_hyperstream.esm.js",
      "default": "./dist/_hyperstream.js"
    },
    "./ext/*": "./dist/ext/*"
  },
  "scripts": {
    "start": "node www/server.js",
    "build": "node build.config.mjs",
    "build:watch": "node build.config.mjs --watch",
    "test": "playwright test --config test/playwright.config.js --project=chromium",
    "test:all": "playwright test --config test/playwright.config.js",
    "test:manual": "node test/manual/server.js",
    "dist": "npm run build && npm run typings",
    "typings": "npx tsc --declaration dist/_hyperstream.esm.js --allowJs --emitDeclarationOnly --skipLibCheck",
    "www": "npm run build && cp -r dist/* www/js/",
    "www:serve": "cd www && npx @11ty/eleventy --serve",
    "www:search": "cd www && npx @11ty/eleventy && npx pagefind --site _site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreahlert/hyperstream.git"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.27.4",
    "markdown-it": "^12.3.2",
    "markdown-it-anchor": "^8.4.1",
    "markdown-it-attrs": "^4.1.3",
    "markdown-it-table-of-contents": "^0.6.0",
    "pagefind": "^1.4.0",
    "serve": "^14.2.6"
  }
}
